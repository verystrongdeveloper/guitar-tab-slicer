{
  "name": "guitar-tab-slicer",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "description": "Desktop app for exporting Guitar Pro and AlphaTex bar-range tab overlay PNGs as a ZIP.",
  "scripts": {
    "dev": "concurrently \"vite --host 0.0.0.0\" \"wait-on http://localhost:5173 && electron .\"",
    "dev:web": "concurrently \"vite --host 0.0.0.0\" \"node --watch server/index.mjs\"",
    "build": "vite build",
    "start": "electron .",
    "serve": "node server/index.mjs",
    "check": "npm run check:electron && npm run check:server",
    "check:electron": "node --check electron/render-service.mjs && node --check electron/main.mjs && node --check electron/preload.cjs",
    "check:server": "node --check server/index.mjs",
    "desktop:pack": "npm run build && node scripts/package-win.mjs portable",
    "desktop:dist": "npm run build && node scripts/package-win.mjs portable"
  },
  "dependencies": {
    "@coderline/alphaskia": "^3.5.147",
    "@coderline/alphatab": "^1.8.3",
    "jszip": "^3.10.1"
  },
  "optionalDependencies": {
    "@coderline/alphaskia-linux": "^3.5.147",
    "@coderline/alphaskia-macos": "^3.5.147",
    "@coderline/alphaskia-windows": "^3.5.147"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cors": "^2.8.6",
    "electron": "^33.2.1",
    "electron-builder": "^24.13.3",
    "express": "^5.2.1",
    "multer": "^2.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "vite": "^6.0.11",
    "wait-on": "^9.0.10"
  },
  "engines": {
    "node": ">=20"
  },
  "build": {
    "appId": "com.guitartabslicer.app",
    "productName": "Guitar Tab Slicer",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules/@coderline/alphaskia-linux/**/*",
      "!node_modules/@coderline/alphaskia-macos/**/*"
    ],
    "asarUnpack": [
      "node_modules/@coderline/alphaskia/**/*",
      "node_modules/@coderline/alphaskia-windows/**/*"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "public/app-icon.ico"
    }
  }
}
