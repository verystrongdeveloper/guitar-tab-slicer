{
  "name": "guitar-tab-slicer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Upload Guitar Pro or alphaTex files and export bar-range guitar tab overlay PNGs as a ZIP.",
  "scripts": {
    "dev": "concurrently \"vite --host 0.0.0.0\" \"node --watch server/index.mjs\"",
    "build": "vite build",
    "start": "node server/index.mjs",
    "check:server": "node --check server/index.mjs"
  },
  "dependencies": {
    "@coderline/alphaskia": "^3.5.147",
    "@coderline/alphatab": "^1.8.3",
    "@vitejs/plugin-react": "^4.3.4",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "jszip": "^3.10.1",
    "multer": "^1.4.5-lts.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.0.11"
  },
  "optionalDependencies": {
    "@coderline/alphaskia-linux": "^3.5.147",
    "@coderline/alphaskia-macos": "^3.5.147",
    "@coderline/alphaskia-windows": "^3.5.147"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=20"
  }
}
